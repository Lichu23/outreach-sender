# Copy this file to .env and fill it in. Never commit .env.

# Practice mode. While true, nothing is sent. Set to false only when you're ready.
DRY_RUN=true

# Who the email comes from.
FROM_NAME=Your Name
FROM_EMAIL=you@yourdomain.com

# Your email provider's SMTP settings.
# Gmail: host smtp.gmail.com, port 465, and an App Password (not your normal password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@yourdomain.com
SMTP_PASS=

# Optional: a postal address for the footer. US law (CAN-SPAM) requires one for US recipients.
SENDER_ADDRESS=

# Maximum emails per day. Values above 50 are lowered to 50.
DAILY_LIMIT=20

# Seconds between emails. Up to 60 random seconds are added. Minimum 30 when really sending.
SEND_DELAY_SECONDS=90
